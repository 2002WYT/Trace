<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Trace" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/trace_paper</item>
        <item name="android:statusBarColor">@color/trace_ink</item>
        <item name="android:navigationBarColor">@color/trace_paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/trace_ink</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
